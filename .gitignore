.claude/

# Build output and local machine configuration.
/.gradle/
/build/
/app/build/
/app/.cxx/
/local.properties

# Cloned by .github/workflows/build.yml at build time, never checked in.
/app/src/main/cpp/cld2_src/

# Written into the tree by CI: the release APK and the signing key.
/easyvoice-release.keystore
/EasyVoice-*.apk

# Downloaded by tools/bootstrap.sh.
/tools/.cache/

__pycache__/
*.pyc

# Compiled by the verify harnesses if they are ever run in place.
*.class
