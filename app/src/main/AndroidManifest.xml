<?xml version="1.0" encoding="utf-8"?>
<!-- NO android:installLocation (2026-10-08). It was "auto", carried over from
     AutoTTS, which let Android move the app to an SD card. Android's own page
     says an app with a SERVICE should not allow that ("Your running Service is
     killed and isn't restarted when external storage is remounted",
     developer.android.com/guide/topics/data/install-location), and the TTS
     engine IS a service: the screen reader would lose its voice until the next
     restart. Without the attribute the app installs on internal storage only,
     Android's default. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" /></intent>
        <intent><action android:name="android.speech.tts.engine.CHECK_TTS_DATA" /></intent>
        <intent><action android:name="android.speech.tts.engine.GET_SAMPLE_TEXT" /></intent>
    </queries>
    <!-- NO QUERY_ALL_PACKAGES (owner, 2026-10-08: "library ke rule ke hisab se").
         It is a Play-restricted permission and lint's QueryAllPackagesPermission
         is an error. The four <queries> intents above are what make every voice
         engine visible: AOSP's AppsFilter matches them against each package's
         own manifest components (AppsFilterUtils.canQueryViaComponents), so any
         app with a TTS_SERVICE service is visible to us, enabled or not, and an
         update swaps its rules in one step (addPackage with isReplace). Every
         package-manager question the app asks is about such an app: the engine
         list, isInstalled, resolveService, checkSignatures, the install-data
         and sample-text screens. The two features that asked about other apps,
         Import and Troubleshoot, are gone. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- No WAKE_LOCK (2026-10-08): AutoTTS declares it and nothing here ever
         took a wake lock, so it was a permission with no use. -->
    <!-- NOTHING LEAVES THE PHONE (owner, 2026-10-28: "internet ki jarurat Nahin
         Hai Kyunki yah to offline kam Karti Hai ml kit ... Har Jagah se internet
         Hata dena"). ML Kit's language identification is a model inside the APK
         and needs no network. These two permissions came only with Google's
         datatransport (transport-runtime 2.2.6 / transport-backend-cct 2.3.3),
         which ML Kit uses to upload its usage logs; that upload path is removed
         below as well, so no log is ever stored or sent. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- Two lint warnings are answered here rather than silenced blindly
         (2026-10-08). DataExtractionRules asks for android:fullBackupContent for
         API 24-30, but allowBackup="false" already turns every kind of backup off
         below Android 12, so such a file would never be read. UnusedAttribute
         names appCategory (API 26) and enableOnBackInvokedCallback (API 33): an
         older platform ignores an attribute it does not know, which is the
         intent. -->
    <application
        tools:ignore="DataExtractionRules,UnusedAttribute"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:appCategory="accessibility"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name">
        <!-- exported with no permission ON PURPOSE (lint ExportedService): a
             TTS engine is bound by any app that speaks, through TextToSpeech
             (directly, or by the system's TextToSpeechManagerService on the
             app's behalf), so a permission would stop the screen reader itself
             from reaching it.
             accessibilityEventTypes / accessibilityFlags / canRetrieveWindowContent
             are gone (2026-10-08): they configure an ACCESSIBILITY service and do
             nothing on a TTS engine's <service>; they came over from AutoTTS's
             manifest. -->
        <service
            tools:ignore="ExportedService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:label="@string/app_name"
            android:name=".EasyVoiceTtsService">
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.speech.tts" android:resource="@xml/tts_engine" />
        </service>
        <activity android:exported="true" android:name=".CheckVoiceData" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:exported="true" android:name=".GetSampleText" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.GET_SAMPLE_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:exported="false" android:label="About" android:name=".AboutActivity" android:theme="@style/AppTheme.NoActionBar" />
        <activity android:exported="false" android:label="Languages" android:name=".LanguagesActivity" android:theme="@style/AppTheme.NoActionBar" />
        <activity android:exported="false" android:label="Mode settings" android:name=".ModeSettingsActivity" android:theme="@style/AppTheme.NoActionBar" />
        <activity android:exported="false" android:label="Voice setup" android:name=".VoiceSetupActivity" android:theme="@style/AppTheme.NoActionBar" />
        <activity android:exported="true" android:name=".MainActivity" android:theme="@style/Theme.EasyVoice.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:authorities="${applicationId}.fileprovider" android:exported="false" android:grantUriPermissions="true" android:name="androidx.core.content.FileProvider">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/provider_paths" />
        </provider>
        <!-- App Startup (androidx.startup) runs SettingsPreload as the process
             starts: it begins reading the DataStore settings file on a
             background thread, so the TTS service's first, blocking read is
             answered from memory (DataStore's own advice for synchronous
             readers). tools:node="merge" adds our entry to the provider the
             libraries already declare. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.sachinbaria.easyvoice.SettingsPreload"
                android:value="androidx.startup" />
        </provider>
        <!-- ML KIT'S LOG UPLOAD, REMOVED (2026-10-28), read in the bytecode of
             the versions this build resolves, not assumed:
             - ML Kit (language-id-common 16.1.0) logs through
               TransportRuntime.newFactory(CCTDestination.INSTANCE), a direct
               class reference, so the cct library itself must stay: without it
               ML Kit's logger would throw NoClassDefFoundError.
             - The backend is FOUND through this manifest, nowhere else:
               MetadataBackendRegistry reads the meta-data of
               TransportBackendDiscovery with getServiceInfo, and a missing
               service is NameNotFoundException, caught there ("Could not
               retrieve metadata, returning empty list of transport backends").
             - With no backend, DefaultScheduler.schedule logs "Transport backend
               'cct' is not registered" and returns BEFORE eventStore.persist and
               workScheduler.schedule, so an event is neither stored nor
               scheduled; it is dropped on the spot, inside its own catch.
             - The job service and the alarm receiver only ever run an upload;
               with no backend there is none to run. Anything datatransport does
               runs on its SafeLoggingExecutor, which catches every Exception, so
               a job left over from an older build cannot take the process down.
             Firebase components and encoders STAY: they are ML Kit's own
             plumbing (MlKitComponentDiscoveryService registers ML Kit's parts
             through them), not a Firebase service, and ML Kit cannot start
             without them. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:node="remove" />
    </application>
</manifest>
